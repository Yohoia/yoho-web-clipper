{
  "manifest_version": 3,
  "name": "拾页",
  "version": "0.6.1",
  "description": "拾页 PageHush Clipper — 拾起灵感，留住好文章。六种方式剪藏网页，保存到页息 PageHush 草稿。",
  "action": {
    "default_title": "拾页 · 保存到页息 PageHush",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup/popup.html",
        "popup/popup.css",
        "popup/about.css",
        "popup/popup.js",
        "icons/icon-128.png",
        "src/preferences.js",
        "src/about.js",
        "src/config.js",
        "src/export.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "short_name": "拾页",
  "options_ui": {
    "page": "options/settings.html",
    "open_in_tab": true
  }
}
